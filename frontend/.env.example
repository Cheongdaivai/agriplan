# ── Local development ────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# The Vite dev proxy rewrites /api → http://localhost:5000, so you only need
# to set VITE_API_URL when running against a remote backend.

# Leave empty locally (proxy handles it). For Netlify, set the full URL:
# VITE_API_URL=https://your-backend-url.com/api
VITE_API_URL=
